# ─── True Mettle ──────────────────────────────────────────────────────────────
# Copy to .env and fill in. Nothing here is required to run the page locally;
# without SMTP the server still stores every enquiry and logs it to the console.

# Where the site is served from. Used for canonical and Open Graph tags only.
SITE_URL=https://truemettle.com

PORT=3000
HOST=0.0.0.0

# Set to 1 when running behind a reverse proxy / load balancer (Fly, Render,
# nginx, Cloudflare) so rate limiting sees the real visitor IP.
TRUST_PROXY=0

# ─── Contact form → email ─────────────────────────────────────────────────────
CONTACT_EMAIL_TO=anjan@example.com
CONTACT_EMAIL_FROM="True Mettle <site@truemettle.com>"
CONTACT_SUBJECT_PREFIX=True Mettle

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Storage ──────────────────────────────────────────────────────────────────
# SQLite file. Point this at a mounted volume in production.
DATABASE_PATH=./data/submissions.db
# Append-only parachute, used only if SQLite cannot be opened.
OVERFLOW_LOG_PATH=./data/submissions.jsonl

# ─── Content ──────────────────────────────────────────────────────────────────
# TBC. Leave empty to render "anjanluthra.com" as plain text instead of a link.
PERSONAL_SITE_URL=https://anjanluthra.com
PERSONAL_SITE_LABEL=anjanluthra.com

# ─── Spam ─────────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000
