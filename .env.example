# ─── True Mettle ──────────────────────────────────────────────────────────────
# Copy to .env for local work. In production these live in the Vercel project's
# Environment Variables, not in a file.
#
# The form needs at least one of DATABASE_URL or RESEND_API_KEY; with
# neither, it answers 503 rather than showing a thank-you for an enquiry that
# would go nowhere.

# ─── Storage ──────────────────────────────────────────────────────────────────
# Either database works; the connection string picks the driver.
#
# Postgres, all in Vercel: Storage → Create Database → Neon, connect it to the
# project, and Vercel sets DATABASE_URL=postgres://… for you.
#
# Or TiDB, which speaks MySQL. TiDB Cloud's connect dialog offers either a
# connection string or the parts separately — set one or the other.
# Run `npm run db:init` once to create the table (the form does it lazily too).
DATABASE_URL=mysql://prefix.user:password@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/truemettle

# …or, the parts:
# TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=prefix.root
# TIDB_PASSWORD=
# TIDB_DATABASE=truemettle

# TiDB Cloud is TLS-only; set to false only for a local MySQL in development.
TIDB_SSL=true

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Alerts to the team and branded confirmations to people who write in. Off
# until RESEND_API_KEY is set. NOTIFY_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
NOTIFY_FROM="True Mettle <admin@truemettle.co>"
NOTIFY_EMAIL=anjan@joindeployed.com
REPLY_TO=anjan@joindeployed.com
CONTACT_SUBJECT_PREFIX=True Mettle

# ─── Content ──────────────────────────────────────────────────────────────────
# Applied at build time by `npm run build`, which Vercel runs on every deploy.
# Leave SITE_URL unset unless the domain differs from the default baked into
# public/index.html.
SITE_URL=https://www.truemettle.co

# Where every "Anjan Luthra" / "Anjan's story" link points. Set to empty to
# render them as plain text instead of links.
PERSONAL_SITE_URL=https://anjanluthra.com

# ─── Admin ────────────────────────────────────────────────────────────────────
# Password for /admin (enquiries + newsletter sign-ups, with CSV export).
# Password only, no username. Leave unset and /admin doesn't exist.
ADMIN_PASSWORD=

# ─── Deck uploads ─────────────────────────────────────────────────────────────
# Vercel Blob. In Vercel: Storage → Create → Blob, connect it to this project,
# and this variable is added for you. Without it the upload box stays hidden
# and founders tell us in a few lines instead.
BLOB_READ_WRITE_TOKEN=

# ─── Spam ─────────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=60

# ─── Local preview only ───────────────────────────────────────────────────────
PORT=3000
