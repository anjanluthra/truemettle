# ─── True Mettle ──────────────────────────────────────────────────────────────
# Copy to .env for local work. In production these live in the Vercel project's
# Environment Variables, not in a file.
#
# The form needs at least one of DATABASE_URL or the SMTP settings; with
# neither, it answers 503 rather than showing a thank-you for an enquiry that
# would go nowhere.

# ─── Storage ──────────────────────────────────────────────────────────────────
# Postgres. The Vercel Postgres and Neon integrations set this for you when you
# attach a database to the project — POSTGRES_URL is also accepted.
# Run `npm run db:init` once to create the table (the form does it lazily too).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ─── Contact form → email ─────────────────────────────────────────────────────
CONTACT_EMAIL_TO=anjan@example.com
CONTACT_EMAIL_FROM="True Mettle <site@truemettle.com>"
CONTACT_SUBJECT_PREFIX=True Mettle

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Content ──────────────────────────────────────────────────────────────────
# Applied at build time by `npm run build`, which Vercel runs on every deploy.
# Leave SITE_URL unset unless the domain differs from the default baked into
# public/index.html.
SITE_URL=https://truemettle.com

# TBC. Set to empty to render "anjanluthra.com" as plain text instead of a link.
PERSONAL_SITE_URL=https://anjanluthra.com
PERSONAL_SITE_LABEL=anjanluthra.com

# ─── Spam ─────────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=60

# ─── Local preview only ───────────────────────────────────────────────────────
PORT=3000
